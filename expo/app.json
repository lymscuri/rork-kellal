{
  "expo": {
    "name": "Kendeya",
    "slug": "jm6yof5nlybu0vv1hh0ta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
